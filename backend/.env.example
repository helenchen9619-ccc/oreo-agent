# 复制为 .env 后按需修改
DEBUG=false

DATABASE_URL=postgresql+asyncpg://ea:oreo_dev_password@postgres:5432/enterprise_agent
REDIS_URL=redis://redis:6379/0

# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
JWT_SECRET=please-change-me
JWT_EXPIRE_HOURS=12

# 飞书自建应用（配置了才启用飞书登录）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 逗号分隔的飞书 open_id，登录自动成为 admin
ADMIN_FEISHU_OPEN_IDS=

# 本地开发用，生产必须 false
DEV_LOGIN_ENABLED=true

SANDBOX_BASE_URL=http://sandbox:8100
