# ===== 密钥与环境（模板除外）=====
.env
.env.*
!.env.example
*.pem
*.key

# ===== Python =====
__pycache__/
*.pyc
.pytest_cache/
.venv/

# ===== Node =====
node_modules/
dist/

# ===== 运行时数据（workspace 上传文件/消息附件/run_code 留痕，云上作为宿主机卷挂载）=====
backend/data/

# ===== 企微会话存档 SDK（腾讯专有二进制，不允许再分发，需自行从官方下载）=====
*.so

# ===== 沙箱离线 wheels（体积大；缺失时 runner.Dockerfile 自动回退在线安装，见 sandbox/wheels/README.md）=====
sandbox/wheels/*
!sandbox/wheels/README.md

# ===== 内部运维资产（不进公开仓库）=====
# 内部开发日志，含事故复盘/真人姓名
ROADMAP.md
# 真实生产域名配置；仓库只带 nginx.conf.example
deploy/nginx.conf
# 依赖真实环境的诊断探针与端到端脚本
backend/check_*.py
backend/e2e_*.py
sandbox/e2e_*

# ===== IDE / 工具 =====
.claude/
.vscode/
.idea/
.research/
.DS_Store
